APP_NAME="CROMMIX BOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crommix_bos
DB_USERNAME=crommix
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=crommix_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@crommixmali.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO / S3 Object Storage
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=crommix-bos
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_URL=http://127.0.0.1:9000

AWS_ACCESS_KEY_ID="${MINIO_KEY}"
AWS_SECRET_ACCESS_KEY="${MINIO_SECRET}"
AWS_DEFAULT_REGION="${MINIO_REGION}"
AWS_BUCKET="${MINIO_BUCKET}"
AWS_ENDPOINT="${MINIO_ENDPOINT}"
AWS_URL="${MINIO_URL}"
AWS_USE_PATH_STYLE_ENDPOINT=true

# Authentik OIDC
AUTHENTIK_BASE_URL=https://auth.crommixmali.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/callback"

VITE_APP_NAME="${APP_NAME}"
